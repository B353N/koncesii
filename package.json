{
  "name": "koncesii",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:docs:test": "node --test scripts/check-docs.test.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "pnpm --filter web start",
    "ingest": "pnpm --filter etl ingest",
    "harvest:upload": "pnpm --filter etl upload",
    "db:push": "pnpm --filter etl push",
    "refresh": "node scripts/refresh.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "miniflare>sharp": "^0.35.4",
      "miniflare>undici": "^7.29.0"
    }
  }
}
